<?xml version="1.0" encoding="utf-8"?>
<!--
     The Desire 510 front panel carries no capacitive or hardware navigation
     keys, so navigation depends on the on-screen bar. The framework default
     of false leaves the phone with no Back, Home, or Recents input and
     hides the System navigation setting.
-->
<resources>
    <bool name="config_showNavigationBar">true</bool>
    <!-- ProcessList scales all six kernel LMK thresholds from the highest
         bucket. Reducing the cached-app threshold from 180 to 96 MiB gives
         reclaim more room before foreground kills on 830 MiB. -->
    <integer name="config_lowMemoryKillerMinFreeKbytesAbsolute">98304</integer>
</resources>
