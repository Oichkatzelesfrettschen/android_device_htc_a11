// The Go and base-system products each request a Tethering APEX with the same manifest name.
// Override both installed modules with one in-process variant for a11chl.
override_apex {
    name: "com.android.tethering.a11chl",
    base: "com.android.tethering",
    package_name: "com.android.tethering.inprocess",
    apps: ["InProcessTethering"],
    overrides: [
        "com.android.tethering",
        "com.android.tethering.inprocess",
    ],
}
